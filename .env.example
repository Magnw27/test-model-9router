# Salin file ini menjadi .env, lalu isi API key milikmu.
# Jika 9Router berjalan di perangkat yang sama, gunakan localhost/127.0.0.1.
# Jika berjalan di perangkat lain, ganti host dengan IP server yang bisa dijangkau.
# Sesuaikan port dengan port API yang ditampilkan oleh konfigurasi 9Router.

NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=isi_api_key_9router_di_sini
